# Salin berkas ini menjadi .env — .env TIDAK boleh di-commit.
#   cp .env.example .env
#
# Ketentuan 8: kredensial yang ter-commit membatalkan nilai artefak sesi itu.
# CI (secret-scan) akan menolak push yang mengandung rahasia.

# --- Basis data -------------------------------------------------------------
# Sesi 3-4: biarkan SQLite. Tidak perlu instalasi apa pun.
DATABASE_URL=sqlite:///./app.db
# Sesi 5 ke atas: ganti ke Postgres gratis dari Neon (https://neon.tech), contoh:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth -------------------------------------------------------------------
# Password ini hanya dipakai ketika akun admin pertama kali dibuat.
INITIAL_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
# Set true di production di belakang HTTPS.
AUTH_COOKIE_SECURE=false
# Set production agar Secure cookie aktif secara default.
ENVIRONMENT=development

# --- CORS (dipakai mulai Sesi 12) -------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
